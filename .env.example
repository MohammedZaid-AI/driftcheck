# Copy this file to .env. Never commit .env.

# Vision provider: ollama (default, local), gemini, hf or groq
VISION_PROVIDER=ollama
# Leave empty to use the model in config/vision.json. Example: qwen2.5vl:7b
VISION_MODEL=
OLLAMA_HOST=http://localhost:11434

# Only needed for the optional providers
GEMINI_API_KEY=
HF_TOKEN=
GROQ_API_KEY=

# Optional overrides
# DRIFTCHECK_DATA_DIR=data
# DRIFTCHECK_CACHE_DIR=cache
# DRIFTCHECK_LOG_LEVEL=INFO
